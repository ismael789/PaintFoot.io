# Supabase (valores publicos para Expo Go y APK)
EXPO_PUBLIC_SUPABASE_URL=https://xlhbsyyapsdmikaxloac.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cCstpdbzH4C5hjfcHErvoQ_wmyfiYZp
# URL publica del servidor de cuentas propio. Nunca uses la clave secreta con EXPO_PUBLIC_.
EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.100:4001/api/auth
AUTH_PORT=4001
# Solo para server.js/.env.local; nunca se incluye en Expo Go ni en el APK.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
# La seguridad de los datos debe aplicarse con RLS en Supabase.
# Nunca agregues una clave secret o service_role a una variable EXPO_PUBLIC_*.

# Herramienta interna. Mantener false para jugadores y produccion.
# Solo aparece en desarrollo cuando el valor es true.
EXPO_PUBLIC_ENABLE_OFFLINE_SIMULATION=false

# IP de la computadora que ejecuta `npm run ws-server`.
# El telefono y la computadora deben estar en la misma red local.
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8082

# Puertos preferidos. Si estan ocupados, el servidor prueba automaticamente
# los siguientes y la app busca el servidor correcto en el mismo rango.
WS_PORT=8082

# Map Matching peatonal. El valor predeterminado usa el servidor publico
# de demostracion de Valhalla; para produccion configura una instancia propia.
EXPO_PUBLIC_MAP_MATCHING_URL=https://valhalla1.openstreetmap.de/trace_attributes

# API Stripe. La app Expo Go y el APK consumen esta URL por HTTP.
EXPO_PUBLIC_STRIPE_API_URL=http://192.168.1.100:4000/api/stripe

# Stripe solo servidor. Nunca usar EXPO_PUBLIC_ ni incluir la clave secreta en la app.
STRIPE_PORT=4000
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_PUBLIC_KEY=pk_test_REEMPLAZAR
STRIPE_CURRENCY=mxn

# IDs price_... creados en Stripe y autorizados para Checkout, separados por coma.
STRIPE_ALLOWED_PRICE_IDS=price_REEMPLAZAR

# Productos de escudo. El servidor fija la duracion; la app nunca envia precio ni horas.
# Si falta un Price ID, Checkout usa el importe por duracion o el importe predeterminado.
STRIPE_SHIELD_1H_PRICE_ID=
STRIPE_SHIELD_6H_PRICE_ID=
STRIPE_SHIELD_12H_PRICE_ID=
STRIPE_SHIELD_24H_PRICE_ID=
STRIPE_SHIELD_36H_PRICE_ID=

# Importes opcionales por duración. Si se omiten, se usa STRIPE_DEFAULT_AMOUNT_CENTS.
STRIPE_SHIELD_1H_AMOUNT_CENTS=
STRIPE_SHIELD_6H_AMOUNT_CENTS=
STRIPE_SHIELD_12H_AMOUNT_CENTS=
STRIPE_SHIELD_24H_AMOUNT_CENTS=
STRIPE_SHIELD_36H_AMOUNT_CENTS=

# Alternativa sin tabla y sin crear un Price permanente en Stripe.
# El importe siempre lo define el servidor, nunca la app.
STRIPE_DEFAULT_ITEM_ID=paintfoot_payment
STRIPE_DEFAULT_ITEM_NAME=Pago PaintFoot.io
STRIPE_DEFAULT_AMOUNT_CENTS=1000

# Redirecciones de Checkout. En produccion deben ser URLs HTTPS controladas.
# Son opcionales en desarrollo local; la API genera una pagina de retorno.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Se obtiene al crear el endpoint o mediante `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR

# Opcional para clientes web. Las apps nativas no necesitan CORS.
STRIPE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Seguridad: una clave sk_live_ se rechaza si esta opcion no es true.
ALLOW_STRIPE_LIVE_MODE=false
